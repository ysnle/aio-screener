+export const SERVER_TRANSLATION_DAILY_BATCHES = 2;
+export function takeServerTranslationSlot({ storage, now = Date.now(), limit = SERVER_TRANSLATION_DAILY_BATCHES } = {}) {
+  const key = 'aio_server_translation_batches_v1';
+  const day = new Date(Number(now) + 9 * 3600000).toISOString().slice(0, 10);
+  try {
+    let state = null;
+    try { state = JSON.parse(storage.getItem(key) || 'null'); } catch (_) { state = null; }
