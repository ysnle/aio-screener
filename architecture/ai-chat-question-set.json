{
  "schemaVersion": "aio-ai-chat-question-set.v1",
  "release": "v60.41",
  "purpose": "Questions a retail investor brings to the AI chat, with pass criteria. scripts/ai-chat-eval.mjs asks the real chat and scores the answers; scripts/ci-ai-chat-question-set-check.mjs validates this file against the committed data without calling the model. Figures are resolved at run time from the app's own data; no number is written here.",
  "tasks": [
    { "id": "market-state", "n": 1, "label": "지금 시장 상태 — 판정과 근거" },
    { "id": "money-flow", "n": 2, "label": "돈이 어디로 가는가 — 섹터, 테마, 종목" },
    { "id": "screen", "n": 3, "label": "조건에 맞는 종목" },
    { "id": "company", "n": 4, "label": "이 회사는 무엇이고 가격은 어디인가" },
    { "id": "holdings", "n": 5, "label": "내 보유 종목과 관심 종목" }
  ],
  "situations": [
    { "id": "closed-market", "label": "장 마감·주말 (종가 기준이 말해져야 함)" },
    { "id": "intraday", "label": "장중 (미국 정규장 중에만 채점)" },
    { "id": "korea", "label": "한국 종목·한국 시장 (보조 시장)" },
    { "id": "etf", "label": "ETF" },
    { "id": "out-of-universe", "label": "앱 유니버스 밖 티커" },
    { "id": "korean-name", "label": "한국어 회사명·별명" },
    { "id": "compare", "label": "두 회사 비교" },
    { "id": "follow-up", "label": "직전 대화에 기대는 후속 질문" },
    { "id": "vague", "label": "막연한 질문" },
    { "id": "definition", "label": "용어 정의" },
    { "id": "on-screen-number", "label": "지금 화면의 숫자에 대한 질문" },
    { "id": "macro-release", "label": "매크로 발표 (CPI, 금리, 환율)" },
    { "id": "web-cause", "label": "웹 검색이 필요한 움직임의 원인" },
    { "id": "earnings", "label": "실적 일정·최근 분기" },
    { "id": "dividend", "label": "배당" },
    { "id": "valuation", "label": "밸류에이션" },
    { "id": "technical", "label": "기술적 상태 (RSI, 이동평균, 52주)" },
    { "id": "scenario-history", "label": "시나리오·과거 사례" },
    { "id": "buy-sell", "label": "매수·매도 요청 (조건부 안내가 답)" },
    { "id": "portfolio-no-consent", "label": "동의 없는 포트폴리오 질문" },
    { "id": "off-topic", "label": "주제 밖 질문" },
    { "id": "false-premise", "label": "틀린 전제가 든 질문" },
    { "id": "table", "label": "표 요청" },
    { "id": "very-short", "label": "아주 짧은 질문" },
    { "id": "very-long", "label": "아주 긴 질문" },
    { "id": "typo-ticker", "label": "오타 티커·회사명" }
  ],
  "defaults": {
    "mustNotContain": [
      "답변 형식이 완성되지 않아",
      "결과를 반환하지 않았습니다",
      "AI 안전 모드",
      "응답할 준비가 되지 않았습니다",
      "답변을 받지 못해",
      "AI 서버를 일시적으로 사용할 수 없습니다",
      "AI 응답이 시간 초과되었습니다",
      "시스템 오류",
      { "regex": "^\\s*(확인\\s*필요|확인 불가)[.\\s]*$", "label": "확인 필요 as the whole answer" }
    ],
    "maxSeconds": { "firstText": 90, "full": 120 }
  },
  "questions": [
    {
      "id": "ms-verdict-closed", "tasks": ["market-state"], "situations": ["closed-market"], "when": "us-closed", "screen": "#signal",
      "question": "지금 미국 시장 위험한 상태야? 판정이랑 근거를 알려줘.",
      "expect": "answer",
      "checks": {
        "figures": [{ "resolver": "history.close:spx", "tolerance": { "abs": 2 } }, { "resolver": "history.close:vix", "tolerance": { "abs": 0.2 } }],
        "mustMention": [["종가", "마감"], ["VIX", "변동성"]]
      },
      "manual": "판정 한 줄이 먼저 오고, 근거가 지수·변동성·시장 폭으로 이어지며, 무엇이 바뀌면 판정이 바뀌는지 말하는가"
    },
    {
      "id": "ms-today-home", "tasks": ["market-state"], "situations": ["closed-market"], "when": "us-closed", "screen": "#home",
      "question": "오늘 시장에서 제일 중요한 일이 뭐였어?",
      "expect": "answer",
      "checks": {
        "figures": [{ "resolver": "history.dayChangePct:spx", "sign": "any", "tolerance": { "abs": 0.15 } }],
        "mustMention": [["S&P", "에스앤피"]]
      },
      "manual": "중요한 일이 경중 순으로 오고, 지수 움직임과 원인이 연결되는가"
    },
    {
      "id": "ms-intraday-nasdaq", "tasks": ["market-state"], "situations": ["intraday"], "when": "us-open", "screen": "#home",
      "question": "지금 장중인데 나스닥 어떻게 움직이고 있어?",
      "expect": "answer",
      "checks": { "mustMention": [["장중", "실시간", "지연", "현재"], ["나스닥"]] },
      "manual": "장중 값과 직전 종가를 구분하고, 장중 값의 시각을 밝히는가"
    },
    {
      "id": "ms-intraday-verdict", "tasks": ["market-state"], "situations": ["intraday"], "when": "us-open", "screen": "#signal",
      "question": "장 열려 있는 지금 시장 판정이 오늘 바뀔 수도 있어?",
      "expect": "answer",
      "checks": { "mustMention": [["종가", "마감"], ["장중"]] },
      "manual": "판정은 종가 기준이라는 점과, 장중 움직임이 어떤 조건이면 판정을 바꾸는지 말하는가"
    },
    {
      "id": "ms-vix-onscreen", "tasks": ["market-state"], "situations": ["on-screen-number", "closed-market"], "screen": "#sentiment",
      "question": "이 화면에 나온 VIX 숫자는 높은 편이야?",
      "expect": "answer",
      "checks": { "figures": [{ "resolver": "history.close:vix", "tolerance": { "abs": 0.2 } }] },
      "manual": "화면의 VIX 값을 그대로 인용하고, 과거 분포나 기준선과 비교해 높고 낮음을 판단하는가"
    },
    {
      "id": "ms-fg-onscreen", "tasks": ["market-state"], "situations": ["on-screen-number"], "screen": "#sentiment",
      "question": "공포탐욕지수 지금 숫자가 뭘 뜻해?",
      "expect": "answer",
      "checks": { "figures": [{ "resolver": "data.path:fearGreed.score", "tolerance": { "abs": 1 } }], "mustMention": [["공포"]] },
      "manual": "숫자와 구간 이름을 맞게 말하고, 극단 구간이 과거에 무엇을 뜻했는지 연결하는가"
    },
    {
      "id": "ms-very-short", "tasks": ["market-state"], "situations": ["very-short"], "screen": "#signal",
      "question": "시장?",
      "expect": "answer",
      "checks": { "mustMention": [["S&P", "지수", "나스닥"]], "maxSeconds": { "firstText": 60, "full": 90 } },
      "manual": "짧은 질문을 현재 시장 상태 질문으로 읽고 판정과 핵심 근거만 짧게 답하는가"
    },
    {
      "id": "ms-vix35-history", "tasks": ["market-state"], "situations": ["scenario-history"], "screen": "#signal",
      "question": "과거에 VIX가 35 이상일 때 S&P 500은 그 뒤 몇 달 동안 어떻게 됐어?",
      "expect": "answer",
      "checks": { "mustMention": [["과거", "사례", "이후"], ["개월", "달"]] },
      "manual": "과거 사례가 구체적 시기·수익률로 제시되고, 표본의 한계와 지금과의 차이를 말하는가"
    },
    {
      "id": "ms-kospi", "tasks": ["market-state"], "situations": ["korea", "closed-market"], "screen": "#signal",
      "question": "한국 시장은 오늘 어땠어? 코스피 기준으로 말해줘.",
      "expect": "answer",
      "checks": {
        "figures": [{ "resolver": "history.close:kospi", "tolerance": { "abs": 5 } }, { "resolver": "history.dayChangePct:kospi", "sign": "any", "tolerance": { "abs": 0.15 } }],
        "mustMention": [["코스피", "KOSPI"]]
      },
      "manual": "코스피 종가와 등락률을 말하고, 미국 시장과의 연결을 보조로 다루는가"
    },
    {
      "id": "ms-false-ath", "tasks": ["market-state"], "situations": ["false-premise"], "screen": "#signal",
      "question": "S&P 500이 어제 사상 최고치를 찍었는데 이대로 계속 오를까?",
      "expect": "answer",
      "checks": {
        "figures": [{ "resolver": "history.dayChangePct:spx", "sign": "any", "tolerance": { "abs": 0.15 } }],
        "mustMention": [["아니", "사실과", "최고치가 아", "하락", "다릅니다"]]
      },
      "manual": "전제가 데이터와 다르면 먼저 바로잡고(최근 종가·등락), 그 위에서 답하는가"
    },
    {
      "id": "ms-very-long", "tasks": ["market-state", "holdings"], "situations": ["very-long", "macro-release"], "screen": "#signal",
      "question": "저는 미국 주식 위주로 투자하는 직장인이고 지금 현금 비중이 30% 정도입니다. 최근 며칠 동안 지수가 크게 빠지고 VIX도 많이 올랐다는 이야기를 들었는데, 금리도 높은 수준이고 환율도 불안해서 지금 상황을 어떻게 봐야 할지 잘 모르겠습니다. 시장 폭이나 투자 심리 같은 지표가 지금 어떤 상태인지, 과거에 비슷한 상황이 있었다면 그 뒤에 시장이 어떻게 움직였는지, 그리고 제가 현금 비중을 유지할지 조금씩 늘려 갈지 판단하려면 앞으로 어떤 지표나 발표를 확인해야 하는지 순서대로 정리해 주세요. 너무 어려운 용어는 풀어서 설명해 주시고, 결론을 먼저 말해 주시면 좋겠습니다.",
      "expect": "conditional-guidance",
      "checks": {
        "figures": [{ "resolver": "history.close:vix", "tolerance": { "abs": 0.2 } }],
        "mustMention": [["현금"], ["확인", "지켜", "발표"]],
        "maxSeconds": { "firstText": 120, "full": 150 }
      },
      "manual": "결론이 먼저 오고, 질문의 네 갈래(지표 상태, 과거 사례, 현금 판단 조건, 확인할 발표)를 모두 순서대로 답하는가"
    },
    {
      "id": "mac-cpi", "tasks": ["market-state"], "situations": ["macro-release"], "screen": "#macro",
      "question": "최근 CPI 발표 결과가 어땠고 시장에는 어떤 의미야?",
      "expect": "answer",
      "checks": { "figures": [{ "resolver": "data.path:macro.cpi", "tolerance": { "abs": 0.1 } }], "mustMention": [["CPI", "소비자물가"]] },
      "manual": "발표 수치와 기준 월을 말하고, 물가 → 금리 → 주식으로 이어지는 경로를 설명하는가"
    },
    {
      "id": "mac-rates", "tasks": ["market-state"], "situations": ["macro-release"], "screen": "#fxbond",
      "question": "지금 기준금리랑 미국 10년물 금리는 몇 %야?",
      "expect": "answer",
      "checks": {
        "figures": [{ "resolver": "data.path:policyRates.fed.upper", "tolerance": { "abs": 0.01 } }, { "resolver": "history.close:tnx", "tolerance": { "abs": 0.03 } }],
        "mustMention": [["10년"]]
      },
      "manual": "기준금리 범위와 10년물 금리를 각각의 기준 시각과 함께 말하는가"
    },
    {
      "id": "mac-usdkrw", "tasks": ["market-state"], "situations": ["macro-release", "korea"], "screen": "#fxbond",
      "question": "원달러 환율 지금 얼마고 왜 이렇게 움직여?",
      "expect": "answer",
      "checks": { "figures": [{ "resolver": "history.close:usdkrw", "tolerance": { "abs": 3 } }], "mustMention": [["원", "환율"]] },
      "manual": "환율 수준을 말하고, 달러 강세·금리차·위험회피 같은 원인을 근거와 함께 연결하는가"
    },
    {
      "id": "mf-sector", "tasks": ["money-flow"], "situations": [], "screen": "#themes",
      "question": "요즘 돈이 어느 섹터로 몰리고 있어?",
      "expect": "answer",
      "checks": { "mustMention": [["섹터"]] },
      "manual": "강한 섹터와 약한 섹터를 수치(상대강도·수익률)로 구분하고, 그 안의 테마로 이어지는가"
    },
    {
      "id": "mf-theme-to-stocks", "tasks": ["money-flow"], "situations": ["vague"], "screen": "#themes",
      "question": "지금 제일 강한 테마 하나 골라서 그 안의 대표 종목까지 알려줘.",
      "expect": "answer",
      "checks": { "mustMention": [["테마"]] },
      "manual": "섹터 → 테마 → 종목 순서로 이어지고, 종목이 그 테마의 실제 구성 종목인가"
    },
    {
      "id": "mf-defense-near-high", "tasks": ["money-flow", "screen"], "situations": ["technical"], "screen": "#themes",
      "question": "방산 테마 안에서 52주 고점 대비 10% 이내에 있는 종목은 뭐야?",
      "expect": "answer",
      "checks": {
        "rowsFromScreen": { "market": "US", "theme": "defense", "conditions": [{ "id": "near-high", "value": 10 }], "sort": { "key": "pctFrom52wHigh", "dir": "desc" }, "limit": 10, "minNamed": 1 }
      },
      "manual": "테마 구성 종목만 말하고, 고점 대비 거리를 종목마다 함께 적는가"
    },
    {
      "id": "mf-korea-theme", "tasks": ["money-flow"], "situations": ["korea"], "screen": "#themes",
      "question": "한국 테마 중에 요즘 강한 건 뭐야?",
      "expect": "answer",
      "checks": { "mustMention": [["한국"], ["테마"]] },
      "manual": "한국 테마를 미국 테마와 섞지 않고, 강한 근거(수익률·순위)를 함께 말하는가"
    },
    {
      "id": "mf-smh-etf", "tasks": ["money-flow"], "situations": ["etf", "closed-market"], "screen": "#themes",
      "question": "반도체 ETF SMH 흐름은 지금 어때?",
      "expect": "answer",
      "checks": { "figures": [{ "resolver": "history.close:smh", "tolerance": { "abs": 0.6 } }], "mustMention": [["SMH"]] },
      "manual": "ETF 가격과 추세를 말하고, 반도체 테마의 흐름과 연결하는가"
    },
    {
      "id": "mf-vague-good", "tasks": ["money-flow"], "situations": ["vague"], "screen": "#home",
      "question": "요즘 뭐가 좋아?",
      "expect": "answer",
      "checks": { "mustMention": [["섹터", "테마", "종목"]] },
      "manual": "막연한 질문을 '강한 섹터·테마'로 해석했음을 밝히고, 근거 있는 후보만 말하는가"
    },
    {
      "id": "sc-value-quality", "tasks": ["screen"], "situations": ["valuation"], "screen": "#screener",
      "question": "PER 20배 이하이면서 ROE 15% 이상인 미국 대형주 알려줘.",
      "expect": "answer",
      "checks": {
        "rowsFromScreen": { "market": "US", "size": ["MEGA", "LARGE"], "conditions": [{ "id": "pe-max", "value": 20 }, { "id": "roe-min", "value": 15 }], "sort": { "key": "roe", "dir": "desc" }, "limit": 10, "minNamed": 3 }
      },
      "manual": "조건을 본문에 다시 적고, 종목마다 PER·ROE를 함께 보여 주는가"
    },
    {
      "id": "sc-trend-new-high", "tasks": ["screen"], "situations": ["technical"], "screen": "#screener",
      "question": "단기 정배열이면서 52주 신고가인 종목 있어?",
      "expect": "answer",
      "checks": {
        "rowsFromScreen": { "market": "US", "conditions": [{ "id": "ma-short" }, { "id": "new-high" }], "limit": 10, "minNamed": 1 }
      },
      "manual": "없으면 없다고 말하고, 있으면 조건을 만족하는 근거를 종목마다 적는가"
