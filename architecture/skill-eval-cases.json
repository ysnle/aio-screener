{
  "schemaVersion": "aio-skill-eval-cases.v1",
  "boundary": "These are deterministic routing and evidence fixtures. They prepare repeatable behavioral runs but do not by themselves prove model output quality.",
  "minimumCasesPerSkill": 3,
  "skills": {
    "bug-fix": [
