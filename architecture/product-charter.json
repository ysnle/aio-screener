      "mustNotContain": ["current-market-observations-presented-as-durable-knowledge", "structural-coverage-presented-as-human-certification"]
    },
    {
      "id": "personal-vault",
      "owner": "user-device",
      "contains": ["explicitly-consented-personal-state"],
      "mustNotContain": ["default-on-chat-history", "plaintext-sensitive-state-presented-as-a-vault"]
    },
    {
      "id": "ai-synthesis",
      "owner": "evidence-bound-orchestrator",
      "contains": ["cited-synthesis", "limitations", "action-permission-state"],
      "mustNotContain": ["uncited-personalized-action", "provider-output-published-before-policy-check"]
    },
    {
      "id": "operations-evidence",
      "owner": "ci-and-observability",
      "contains": ["immutable-revision-bound-artifacts", "environment", "command", "timestamp", "gate-status"],
      "mustNotContain": ["mechanically-version-bumped-measurements", "local-pass-presented-as-live-proof"]
    }
  ],
