  "productIdentity": {
    "name": "AIO Screener",
    "category": "self-directed-investment-research-and-decision-support",
    "primaryUser": "Korean-speaking self-directed investor who needs one evidence-bound research workflow",
    "primaryJob": "Observe market state, triage opportunities and risks, compare evidence, and record a reviewable thesis without mistaking incomplete public data for execution-grade truth",
    "executionCapability": "NONE",
    "stage": "RESEARCH_BETA_CONDITIONAL"
  },
  "allowedOutcomes": [
    "observe-market-state",
    "screen-and-triage",
    "compare-evidence",
    "explain-uncertainty-and-limitations",
    "journal-thesis-and-review-outcome",
    "learn-market-principles"
  ],
  "nonGoals": [
    "brokerage-order-routing-or-trade-execution",
    "individualized-buy-sell-sizing-or-timing-instructions-without-suitability-and-current-decision-evidence",
    "licensed-professional-real-time-terminal-parity",
    "claiming-real-time-from-best-effort-public-data",
    "general-purpose-chatbot",
    "full-cms-backtest-or-portfolio-accounting-platform"
  ],
  "experiencePrinciples": [
    "evidence-before-opinion",
    "progressive-disclosure-for-novice-and-expert-density",
    "research-and-action-language-are-separated",
    "missing-is-never-zero",
    "degraded-and-stale-states-remain-visible",
    "one-primary-workflow-before-feature-breadth"
  ],
  "evidencePolicy": {
    "allowedUseOrder": ["none", "reference", "decision"],
    "monotonicRestriction": true,
    "requiredFields": ["sourceKind", "observedAt", "status", "allowedUse", "freshness"],
    "decisionUseRequires": ["current-enough-for-domain", "source-rights-compatible", "validated-provenance", "non-synthetic-observation"],
    "claimRules": {
      "realTime": "FORBIDDEN_UNLESS_SOURCE_RIGHTS_AND_MEASURED_LATENCY_ARE_EXPLICIT",
      "missingObservation": "UNKNOWN_NOT_ZERO",
      "derivedMetric": "LABEL_INPUTS_METHOD_AND_LIMITATIONS",
      "staleObservation": "REFERENCE_OR_NONE_ONLY"
    }
  },
  "trustPlanes": [
    {
      "id": "public-shell",
      "owner": "github-pages",
      "contains": ["versioned-ui-shell", "small-public-projections", "static-reference-content"],
      "mustNotContain": ["secrets", "private-portfolio-records", "unbounded-bulk-market-history"]
    },
    {
      "id": "durable-current-data",
      "owner": "scheduled-data-pipeline",
      "contains": ["validated-snapshots", "lineage", "freshness", "publication-status"],
