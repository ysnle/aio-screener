# Local scratch / legacy artifacts — never meant to ship or be tracked.
# See _context/BUG-POSTMORTEM.md P572 session (v51.84) for why this file exists:
# repo had zero .gitignore, so these accumulated as permanent `git status` noise.

# Pre-edit backup hoard from a deprecated v30-era rule (working-rules.md §1/§6a,
# itself gitignored below) that mandated copying the whole file before every edit.
# Superseded by git history; these .bak snapshots are redundant with old commits.
_backup/

# Same 2026-04-17 .bak snapshots as above, relocated out of _backup/ during the
# 2026-07-04 config audit for tidiness. Still redundant with git history.
_archive/_backup-2026-04-17-legacy/

# Build/dev output scratch.
outputs/

# Generated local Codex skill mirror and other machine-local agent state.
.agents/

# Legacy Codex-only governance docs that duplicate/contradict the current
# git-tracked _context/RULES.md + QA-CHECKLIST.md (e.g. mandatory-backup-before-edit,
# "never delete files" — both superseded). Kept locally for history, not tracked.
_context/working-rules.md
_context/voice-and-style.md
_context/archive-reports/

# Autoresearch outputs are ephemeral working state, not committed artifacts.
autoresearch-*/

# CI-only tooling deps (Phase 2 B5 headless test runner). App itself ships
# zero dependencies — this is Playwright for scripts/ci-headless-tests.mjs only.
node_modules/

# Personal local permission overrides (Claude Code convention: settings.local.json
# is machine-specific, never shared). Was previously committed by mistake — the
# Stop-hook auto-commit's `git add -A` swept it in along with real WIP changes.
# `git rm --cached` it once to stop future re-tracking (2026-07-04 config audit).
.claude/settings.local.json

# v52.47 WO-5: SessionStart hook's per-session git-status snapshot (session-start-snapshot.sh) —
# working state for auto-commit-on-stop.sh's scoping, not a committed artifact. Removed by the
# Stop hook itself on normal exit, but ignore it too in case a session ends without running Stop.
# Separate files per tool (.claude/ vs .codex/) so two concurrent sessions from different tools
# against the same repo don't clobber each other's snapshot mid-session.
.claude/.session-start-snapshot
.codex/.session-start-snapshot
debug.log
