{
  "description": "Portable, advisory AIO workspace hooks. They never commit, push, deploy, or rewrite user work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" guard-edit",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel); node (Join-Path $r 'scripts/agent-hook.mjs') guard-edit\"",
            "timeout": 10,
            "statusMessage": "Protecting archived evidence"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" guard-command",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel); node (Join-Path $r 'scripts/agent-hook.mjs') guard-command\"",
            "timeout": 10,
            "statusMessage": "Checking destructive-command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" post-edit",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel); node (Join-Path $r 'scripts/agent-hook.mjs') post-edit\"",
            "timeout": 20,
            "statusMessage": "Checking affected AIO contracts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hook.mjs\" session-start",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r=(git rev-parse --show-toplevel); node (Join-Path $r 'scripts/agent-hook.mjs') session-start\"",
            "timeout": 10,
            "statusMessage": "Loading generated AIO workspace state",
            "additionalContextLimit": 3000
          }
        ]
      }
    ]
  }
}
